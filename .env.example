# ── Bot configuration (Railway variables / local .env) ────────────────────
# Copy to .env (git-ignored) or set as Railway variables. Never commit secrets.

# Required
TELEGRAM_BOT_TOKEN=your_bot_token_here
DATABASE_URL=postgresql://user:pass@localhost:5432/dbname

# ── Feed source ────────────────────────────────────────────────────────────
# Dedicated RSSHub (recommended, no X API token needed):
#   RSSHUB_BASE_URL = URL of your RSSHub instance (see README → Dedicated RSSHub)
#   RSSHUB_ACCESS_KEY = the instance's ACCESS_KEY, if you set one
# Defaults to the public https://rsshub.app plus public Nitter mirrors.
#RSSHUB_BASE_URL=http://localhost:1200
#RSSHUB_ACCESS_KEY=

# Optional: official X API v2 Bearer Token — used when configured; the
# dedicated RSSHub path above works without it.
#X_BEARER_TOKEN=

# ── Translation (optional) ─────────────────────────────────────────────────
#TRANSLATE_FA=true
#REQUESTY_API_KEY=your_gemini_api_key
#REQUESTY_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#REQUESTY_MODEL=gemini-2.0-flash

# ── Tuning (see README for the full list) ──────────────────────────────────
#CHECK_INTERVAL=300
#RSS_FETCH_TIMEOUT=12
#RSS_FETCH_CONCURRENCY=12
#MAX_TWEETS_PER_CHECK=10
# Circuit breaker base threshold for dead public mirrors. The app scales the
# actual threshold to at least 2x the tracked-account count during each scan;
# account-specific HTTP 404s and empty HTTP 200 feeds do not count as hard errors.
#MIRROR_BREAKER_SAMPLE=12
#MIRROR_BREAKER_COOLDOWN=1800
# Backoff after HTTP 429 — a throttled mirror is alive, not dead, so it gets
# this short pause instead of the long bench and does not count as a failure.
#MIRROR_RATE_LIMIT_COOLDOWN=120
#LOG_LEVEL=INFO
