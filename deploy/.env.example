# ── deploy/docker-compose.yml environment ─────────────────────────────────
# Copy to deploy/.env and fill in. Never commit the real file.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Password for the bundled PostgreSQL (pick something long and random)
POSTGRES_PASSWORD=

# Cookie `auth_token` of a logged-in X account — this replaces the paid X API.
# How to get it: log in to x.com in a browser → F12 → Application → Cookies →
# x.com → copy the value of `auth_token`. Use a dedicated/burner account and
# do not log that browser session out. Multiple accounts: comma-separated.
TWITTER_AUTH_TOKEN=

# Shared secret between RSSHub and the bot. Set the SAME value as the bot's
# RSSHUB_ACCESS_KEY. Leave empty only for a firewalled/local instance.
RSSHUB_ACCESS_KEY=

# ── Optional ───────────────────────────────────────────────────────────────
# X often blocks datacenter IPs. If feeds return nothing, set a proxy:
#   http://user:pass@host:port   or   socks5h://host:port
#RSSHUB_PROXY_URI=

# Advanced: route X GraphQL calls through a third-party API mirror instead of
# a proxy (leave empty unless you run such a bridge yourself)
#TWITTER_THIRD_PARTY_API=

# Translation via Gemini (or any OpenAI-compatible provider)
#GEMINI_API_KEY=
#REQUESTY_API_KEY=
#REQUESTY_MODEL=gemini-2.0-flash
#TRANSLATE_FA=true

# Dashboard port on the host (container port stays 8080)
#DASHBOARD_PORT=8080

# Seconds between feed checks
#CHECK_INTERVAL=300
#LOG_LEVEL=INFO
